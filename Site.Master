<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">CodeFusion</asp:ContentPlaceHolder> · CodeFusion</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="~/Content/css/theme.css" runat="server" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <nav class="cf-nav">
            <div class="cf-nav-inner">
                <a href="~/Default.aspx" runat="server" class="cf-logo">
                    <span class="cf-logo-mark">&lt;/&gt;</span>
                    CodeFusion<span class="dot">.</span>
                </a>

                <div class="cf-nav-links" id="cfNavLinks" runat="server">
                    <asp:PlaceHolder ID="phStudentLinks" runat="server" Visible="false">
                        <a href="~/Student/Dashboard.aspx" runat="server">Dashboard</a>
                        <a href="~/Student/Roadmap.aspx" runat="server">Learn</a>
                        <a href="~/Practice/Index.aspx" runat="server">Practice</a>
                        <a href="~/Practice/DebugLab.aspx" runat="server">Debug Lab</a>
                        <a href="~/Student/QuizArena.aspx" runat="server">Quiz Arena</a>
                        <a href="~/Student/Progress.aspx" runat="server">Progress</a>
                        <a href="~/Student/Achievements.aspx" runat="server">Achievements</a>
                        <a href="~/Student/Materials.aspx" runat="server">Materials</a>
                        <a href="~/Student/Bookmarks.aspx" runat="server">Bookmarks</a>
                        <a href="~/Student/Notes.aspx" runat="server">Notes</a>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder ID="phGuestLinks" runat="server" Visible="false">
                        <a href="~/Default.aspx" runat="server">Home</a>
                        <a href="~/Default.aspx#features" runat="server">Features</a>
                        <a href="~/Default.aspx#roadmap-preview" runat="server">Roadmap</a>
                    </asp:PlaceHolder>
                </div>

                <div class="cf-nav-right">
                    <asp:PlaceHolder ID="phStudentRight" runat="server" Visible="false">
                        <span class="pill pill-green" title="XP"><i class="fa-solid fa-bolt"></i> <asp:Literal ID="litNavXP" runat="server" /> XP</span>
                        <button type="button" class="cf-nav-icon-btn" title="Notifications"><i class="fa-regular fa-bell"></i></button>
                        <a href="~/Student/Profile.aspx" runat="server" class="cf-avatar" title="Profile"><asp:Literal ID="litAvatarInitial" runat="server" /></a>
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-cf btn-cf-ghost btn-cf-sm" OnClick="btnLogout_Click"><i class="fa-solid fa-right-from-bracket"></i></asp:LinkButton>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder ID="phGuestRight" runat="server" Visible="false">
                        <a href="~/Login.aspx" runat="server" class="btn-cf btn-cf-ghost btn-cf-sm">Log in</a>
                        <a href="~/Register.aspx" runat="server" class="btn-cf btn-cf-primary btn-cf-sm">Get Started</a>
                    </asp:PlaceHolder>
                    <button type="button" class="cf-navtoggle" id="cfNavToggle"><i class="fa-solid fa-bars"></i></button>
                </div>
            </div>
        </nav>

        <main class="cf-main">
            <div class="cf-shell">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>

        <footer class="cf-footer">
            <div class="cf-shell" style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                <span>CodeFusion — Learn ASP.NET. Build. Practice. Debug. Master.</span>
                <span>Built for learning · ASP.NET Web Forms · C# · SQL Server</span>
            </div>
        </footer>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
