<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="CodeFusionDB" connectionString="Server=(localdb)\MSSQLLocalDB;Database=CodeFusionDB;Trusted_Connection=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="MaterialsUploadPath" value="~/Uploads/Materials/"/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="20480"/>
    <!-- Session-based authentication -->
    <sessionState mode="InProc" timeout="60" cookieless="false"/>
    <!-- Never leak raw server/DB errors to students -->
    <customErrors mode="Off" defaultRedirect="~/ErrorPages/GenericError.aspx">
      <error statusCode="404" redirect="~/ErrorPages/NotFound.aspx"/>
    </customErrors>
    <authentication mode="None"/>
    <!-- Auth is handled manually via Session in App_Code/BLL/AuthBLL.cs
         and enforced per-page in Page_Load (see Student/Dashboard.aspx.cs) -->
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID"/>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
    <httpErrors errorMode="Detailed" existingResponse="PassThrough">
      <remove statusCode="500"/>
      <error statusCode="500" path="/ErrorPages/GenericError.aspx" responseMode="ExecuteURL"/>
    </httpErrors>
  </system.webServer>
</configuration>