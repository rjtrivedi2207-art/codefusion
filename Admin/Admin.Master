<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Admin.Master.cs" Inherits="AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin</asp:ContentPlaceHolder> · CodeFusion Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="~/Content/css/theme.css" runat="server" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <nav class="cf-nav">
            <div class="cf-nav-inner">
                <a href="~/Admin/Dashboard.aspx" runat="server" class="cf-logo">
                    <span class="cf-logo-mark">&lt;/&gt;</span>CodeFusion<span class="dot">.</span>
                    <span class="pill pill-violet" style="margin-left:8px;">Admin</span>
                </a>
                <div class="cf-nav-links" id="cfNavLinks" runat="server">
                    <a href="~/Admin/Dashboard.aspx" runat="server">Dashboard</a>
                    <a href="~/Admin/Students.aspx" runat="server">Students</a>
                    <a href="~/Admin/Materials.aspx" runat="server">Materials</a>
                    <a href="~/Admin/Modules.aspx" runat="server">Modules</a>
                    <a href="~/Admin/Lessons.aspx" runat="server">Lessons</a>
                    <a href="~/Admin/Quizzes.aspx" runat="server">Quizzes</a>
                    <a href="~/Admin/Challenges.aspx" runat="server">Challenges</a>
                    <a href="~/Admin/Results.aspx" runat="server">Results</a>
                </div>
                <div class="cf-nav-right">
                    <span class="text-muted-cf" style="font-size:13px;"><asp:Literal ID="litAdminName" runat="server" /></span>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-cf btn-cf-ghost btn-cf-sm" OnClick="btnLogout_Click">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </asp:LinkButton>
                    <button type="button" class="cf-navtoggle" id="cfNavToggle"><i class="fa-solid fa-bars"></i></button>
                </div>
            </div>
        </nav>
        <main class="cf-main">
            <div class="cf-shell">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
